{
    "name": "pwrplugins/portfolio-elementor",
    "description": "Portfolio & Image Gallery for Elementor",
    "type": "wordpress-plugin",
    "require": {
        "freemius/wordpress-sdk": "^2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "yoast/phpunit-polyfills": "^1.0",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "PowerfolioPlugin\\": "classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PowerfolioPlugin\\Tests\\": "tests/phpunit/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
